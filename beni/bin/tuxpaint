#!/bin/sh
# pt_BR se o idioma estiver instalado (o Ubuntu vem em inglês).
case "$0" in
  */*) _COZY_LOCALE="$(dirname "$0")/cozy-locale" ;;
  *) _COZY_LOCALE="$HOME/.local/bin/cozy-locale" ;;
esac
[ -r "$_COZY_LOCALE" ] || _COZY_LOCALE="$HOME/.local/bin/cozy-locale"
[ -r "$_COZY_LOCALE" ] && . "$_COZY_LOCALE"
unset _COZY_LOCALE
# Cozy Kids Launcher: abre o Tux Paint novo (Flathub) em tela cheia, sem trocar a resolução.
# --nolockfile: sem ele, abrir de novo menos de 30 s depois sai sem janela (a criança acha
# que "não abriu"; roteiro 33, no Windows).
# O flatpak não herda o LANG do atalho: sem --env ele abre em inglês. --lang e o
# tuxpaint.cfg pedem pt_BR mesmo quando a sessão da família continua en_US.
_TP_DIR="$HOME/.var/app/org.tuxpaint.Tuxpaint/.tuxpaint"
_TP_CFG="$_TP_DIR/tuxpaint.cfg"
mkdir -p "$_TP_DIR"
if [ -f "$_TP_CFG" ]; then
  grep -v '^lang=' "$_TP_CFG" > "$_TP_CFG.tmp" 2>/dev/null || true
  printf 'lang=pt_BR\n' >> "$_TP_CFG.tmp"
  mv "$_TP_CFG.tmp" "$_TP_CFG"
else
  printf 'lang=pt_BR\n' > "$_TP_CFG"
fi
exec flatpak run \
  --env=LANG=pt_BR.UTF-8 \
  --env=LC_ALL=pt_BR.UTF-8 \
  --env=LANGUAGE=pt_BR:pt \
  org.tuxpaint.Tuxpaint --fullscreen=native --nolockfile --lang pt_BR
