#!/bin/sh
# pt_BR se o idioma estiver instalado (o Ubuntu vem em inglês).
case "$0" in
  */*) _COZY_LOCALE="$(dirname "$0")/cozy-locale" ;;
  *) _COZY_LOCALE="$HOME/.local/bin/cozy-locale" ;;
esac
[ -r "$_COZY_LOCALE" ] || _COZY_LOCALE="$HOME/.local/bin/cozy-locale"
[ -r "$_COZY_LOCALE" ] && . "$_COZY_LOCALE"
unset _COZY_LOCALE
# Cozy Kids Launcher: abre jogos de navegador (ex.: Universo Rabisco) no Chromium,
# que neste notebook roda os jogos 3D quase 2x mais rápido que o Firefox.
# Uso: navegador-jogos <url>
# A extensão cozy-controle entrega os controles USB aos jogos no formato padrão,
# com os botões configurados na área dos pais (mapa.js é gerado pelo launcher).
# O Chromium novo só aceita --load-extension com a função abaixo desligada.
EXT="$HOME/.var/app/org.chromium.Chromium/cozy-controle"
URL="$1"; set --
[ -f "$EXT/manifest.json" ] && set -- --load-extension="$EXT"
# Tela de carregamento por cima até o navegador estar em tela cheia
python3 "$HOME/.local/lib/cozy-fixes/carregando.py" chromium >/dev/null 2>&1 &
# Perfil SÓ deste quiosque (não é o Chromium dos pais, nem política do sistema):
# sem pop-up e sem download. O seletor de arquivos clássico não tem preferência;
# nos jogos da moldura o sandbox do cozy-jogo.html já o segura (sem allow-popups
# e sem allow-downloads). Um site aberto direto nesta janela ainda pode mostrar
# o diálogo GTK de arquivo — não há vigia de janela no Linux.
PERFIL="$HOME/.var/app/org.chromium.Chromium/cozy-jogos"
python3 - "$PERFIL" <<'PY'
import json, os, sys
caminho = os.path.join(sys.argv[1], "Default", "Preferences")
wanted = {
    "download_restrictions": 3,
    "profile": {"default_content_setting_values": {"popups": 2, "automatic_downloads": 2}},
}
def merge(atual, novo):
    mudou = False
    for chave, valor in novo.items():
        if isinstance(valor, dict):
            if not isinstance(atual.get(chave), dict):
                atual[chave] = {}
                mudou = True
            mudou = merge(atual[chave], valor) or mudou
        elif atual.get(chave) != valor or type(atual.get(chave)) is not type(valor):
            atual[chave] = valor
            mudou = True
    return mudou
try:
    with open(caminho, encoding="utf-8") as handle:
        dados = json.load(handle)
except FileNotFoundError:
    dados = {}
except (OSError, ValueError):
    dados = None
if isinstance(dados, dict) and merge(dados, wanted):
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    tmp = caminho + ".benikids-tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(dados, handle, ensure_ascii=False, separators=(",", ":"))
        os.replace(tmp, caminho)
    except OSError:
        pass
PY
exec flatpak run org.chromium.Chromium \
  --user-data-dir="$PERFIL" \
  --kiosk --no-first-run --no-default-browser-check --noerrdialogs \
  --disable-session-crashed-bubble --hide-crash-restore-bubble \
  --disable-translate --disable-features=Translate,TranslateUI,DnsOverHttps,FileSystemAccessAPI,DisableLoadExtensionCommandLineSwitch --password-store=basic \
  --ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy \
  --autoplay-policy=no-user-gesture-required --lang=pt-BR \
  "$@" "$URL"
