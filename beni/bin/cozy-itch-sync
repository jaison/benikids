#!/usr/bin/env python3
"""Invólucro da sincronização das coleções do itch.io.

A lógica está em itch_sync.py, a mesma que a thread do servidor usa no
Windows e no Linux. Este script continua no timer do systemd e no login.
"""
import os
import sys

_AQUI = os.path.dirname(os.path.abspath(__file__))
_CANDIDATOS = (
    os.path.abspath(os.path.join(_AQUI, "..", "..", "src")),
    os.path.join(os.path.expanduser("~"), ".local", "share", "cozy-kids-launcher"),
)
for _caminho in _CANDIDATOS:
    if os.path.isfile(os.path.join(_caminho, "itch_sync.py")):
        if _caminho not in sys.path:
            sys.path.insert(0, _caminho)
        break

import itch_sync  # noqa: E402


if __name__ == "__main__":
    sys.exit(itch_sync.main())
