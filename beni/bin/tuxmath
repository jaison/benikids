#!/bin/sh
# pt_BR se o idioma estiver instalado (o Ubuntu vem em inglês).
case "$0" in
  */*) _COZY_LOCALE="$(dirname "$0")/cozy-locale" ;;
  *) _COZY_LOCALE="$HOME/.local/bin/cozy-locale" ;;
esac
[ -r "$_COZY_LOCALE" ] || _COZY_LOCALE="$HOME/.local/bin/cozy-locale"
[ -r "$_COZY_LOCALE" ] && . "$_COZY_LOCALE"
unset _COZY_LOCALE
# Wrapper do Cozy Kids Launcher: nao deixa o TuxMath prender o mouse (o botao X precisa funcionar).
LD_PRELOAD="$HOME/.local/lib/cozy-fixes/nograb.so${LD_PRELOAD:+:$LD_PRELOAD}" exec /usr/games/tuxmath "$@"
